# Copy to .env.local and fill in from your Supabase project settings.
# The app runs fully without these — IndexedDB is the source of truth and the
# sync queue stays inert until credentials are present.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Dev only. Pretends a session exists so gated screens can be opened
# without signing in. Ignored entirely in production builds.
VITE_DEV_USER_ID=
